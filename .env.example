# Copy this file to .env and set a real, strong password before running
# `docker compose up`. .env is git-ignored; never commit real credentials.
#
# This single value is used both as the SQL Server "sa" login password
# (SQL_SA_PASSWORD, consumed by the sqlserver service) and as the SQL
# authentication secret the API uses to connect (Db__SqlAuthSecret,
# consumed by the api service). The base connection string in
# docker-compose.yml does not contain any credential.
SQL_SA_PASSWORD=Your_Strong_Passw0rd!
